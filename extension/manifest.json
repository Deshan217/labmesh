{
  "manifest_version": 3,
  "name": "LabMesh",
  "version": "0.1.0",
  "description": "Share a workshop file across nearby laptops and explain live transfer status with Gemini.",
  "action": {
    "default_title": "Open LabMesh"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' ws://127.0.0.1:8765"
  }
}
